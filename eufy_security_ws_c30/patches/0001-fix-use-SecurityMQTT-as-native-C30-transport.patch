+import { Station } from "../http/station";
+
+describe("Station SecurityMQTT connectivity", () => {
+  function createStation(p2pConnected: boolean): Station {
+    const station = Object.create(Station.prototype) as Station;
+    (station as any).p2pSession = {
+      isConnected: () => p2pConnected,
+    };
+    (station as any).securityMqttConnected = false;
+    return station;
+  }
+
+  it("reports a SecurityMQTT-only station as connected", () => {
+    const station = createStation(false);
+
+    expect(station.isConnected()).toBe(false);
+    station.setSecurityMqttConnected(true);
+    expect(station.isConnected()).toBe(true);
+    station.setSecurityMqttConnected(false);
+    expect(station.isConnected()).toBe(false);
+  });
+
+  it("does not hide a live P2P connection when SecurityMQTT disconnects", () => {
+    const station = createStation(true);
+
+    station.setSecurityMqttConnected(true);
+    station.setSecurityMqttConnected(false);
+    expect(station.isConnected()).toBe(true);
+  });
+});
