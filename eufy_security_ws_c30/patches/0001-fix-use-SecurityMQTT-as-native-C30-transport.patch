+  /**
+   * Keep station connectivity aligned with the real transport used by C30-class locks.
+   *
+   * The websocket API exposes Station.isConnected() to integrations. For
+   * SecurityMQTT-only locks, reporting only the intentionally absent P2P
+   * session makes a working lock look offline and triggers pointless DSK
+   * reconnect attempts.
+   */
+  private setSecurityMqttConnectionState(connected: boolean): void {
+    const handledStations = new Set<string>();
+
+    for (const device of Object.values(this.devices)) {
+      if (!device.usesSecurityMqtt()) {
+        continue;
+      }
+
+      const stationSN = device.getStationSerial();
+      if (handledStations.has(stationSN)) {
+        continue;
+      }
+      handledStations.add(stationSN);
+
+      const station = this.stations[stationSN];
+      if (!station) {
+        rootMainLogger.debug("SecurityMQTT station state update skipped - station not found", {
+          stationSN,
+        });
+        continue;
+      }
+
+      const wasConnected = station.isConnected();
+      station.setSecurityMqttConnected(connected);
+      const isConnected = station.isConnected();
+
+      if (!wasConnected && isConnected) {
+        rootMainLogger.info("Station connected through SecurityMQTT", { stationSN });
+        this.onStationConnect(station);
+      } else if (wasConnected && !isConnected) {
+        rootMainLogger.info("Station disconnected from SecurityMQTT", { stationSN });
+        this.onStationClose(station);
+      }
+    }
+  }
